<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fitsSystemWindows="true"
    android:orientation="vertical"
    android:paddingStart="20dp"
    android:paddingTop="12dp"
    android:paddingEnd="20dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="12dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ImageButton
            android:id="@+id/back_button"
            style="@style/IconButton"
            android:layout_marginStart="-12dp"
            android:contentDescription="@string/back"
            android:src="@drawable/ic_back" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:text="@string/settings"
            android:textColor="@color/text"
            android:textSize="24sp"
            android:textStyle="bold" />
    </LinearLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingBottom="20dp">

            <LinearLayout style="@style/Card">

                <TextView
                    style="@style/Label"
                    android:text="@string/output_label" />

                <Switch
                    android:id="@+id/cci_switch"
                    style="@style/SettingSwitch"
                    android:text="@string/cci_switch" />

                <TextView
                    style="@style/SettingHint"
                    android:text="@string/cci_switch_hint" />

                <Switch
                    android:id="@+id/strip_title_id_switch"
                    style="@style/SettingSwitch"
                    android:layout_marginTop="12dp"
                    android:text="@string/strip_title_id_switch" />

                <TextView
                    style="@style/SettingHint"
                    android:text="@string/strip_title_id_hint" />
            </LinearLayout>

            <LinearLayout style="@style/Card">

                <TextView
                    style="@style/Label"
                    android:text="@string/after_label" />

                <Switch
                    android:id="@+id/delete_switch"
                    style="@style/SettingSwitch"
                    android:text="@string/delete_switch" />

                <TextView
                    style="@style/SettingHint"
                    android:text="@string/delete_switch_hint" />
            </LinearLayout>

            <LinearLayout style="@style/Card">

                <TextView
                    style="@style/Label"
                    android:text="@string/updates_label" />

                <Switch
                    android:id="@+id/sort_updates_switch"
                    style="@style/SettingSwitch"
                    android:text="@string/sort_updates_switch" />

                <TextView
                    style="@style/SettingHint"
                    android:text="@string/sort_updates_hint" />

                <LinearLayout
                    android:id="@+id/update_folder_row"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/update_folder_path"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginEnd="12dp"
                        android:layout_weight="1"
                        android:ellipsize="end"
                        android:maxLines="2"
                        android:textColor="@color/text"
                        android:textSize="16sp" />

                    <Button
                        android:id="@+id/update_folder_reset"
                        style="@style/SecondaryButton"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginEnd="8dp"
                        android:text="@string/use_default" />

                    <Button
                        android:id="@+id/update_folder_button"
                        style="@style/SecondaryButton"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/choose_folder" />
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>
    </ScrollView>
</LinearLayout>
