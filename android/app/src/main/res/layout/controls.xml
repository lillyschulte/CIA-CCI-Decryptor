<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/app_name"
        android:textColor="@color/text"
        android:textSize="24sp"
        android:textStyle="bold" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="16dp"
        android:text="@string/subtitle"
        android:textColor="@color/text_dim" />

    <!-- Shown until "All files access" is granted -->
    <LinearLayout
        android:id="@+id/permission_card"
        style="@style/Card">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/access_title"
            android:textColor="@color/accent"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:layout_marginBottom="12dp"
            android:text="@string/access_body"
            android:textColor="@color/text" />

        <Button
            android:id="@+id/grant_button"
            style="@style/PrimaryButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/grant" />
    </LinearLayout>

    <LinearLayout style="@style/Card">

        <TextView
            style="@style/Label"
            android:text="@string/folder_label" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/folder_path"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginEnd="12dp"
                android:layout_weight="1"
                android:breakStrategy="simple"
                android:ellipsize="end"
                android:maxLines="2"
                android:textColor="@color/text"
                android:textSize="16sp" />

            <Button
                android:id="@+id/folder_button"
                style="@style/SecondaryButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/choose_folder" />
        </LinearLayout>

        <TextView
            android:id="@+id/rom_summary"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:maxLines="8"
            android:ellipsize="end"
            android:textColor="@color/text_dim" />
    </LinearLayout>

    <LinearLayout style="@style/Card">

        <TextView
            style="@style/Label"
            android:text="@string/output_label" />

        <Switch
            android:id="@+id/cci_switch"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="48dp"
            android:text="@string/cci_switch"
            android:textColor="@color/text"
            android:textSize="16sp"
            android:thumbTint="@color/switch_thumb"
            android:trackTint="@color/switch_track" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:text="@string/cci_switch_hint"
            android:textColor="@color/text_dim" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="12dp"
        android:orientation="horizontal">

        <Button
            android:id="@+id/decrypt_button"
            style="@style/PrimaryButton"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/decrypt" />

        <Button
            android:id="@+id/cancel_button"
            style="@style/SecondaryButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:text="@string/cancel"
            android:textColor="@color/danger"
            android:visibility="gone" />
    </LinearLayout>
</LinearLayout>
